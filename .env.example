# Deterministic analytics work without an LLM.
LLM_ENABLED=false
LLM_PROVIDER=together
TOGETHER_API_KEY=
TOGETHER_MODEL=openai/gpt-oss-120b
TOGETHER_TIMEOUT_SECONDS=20

# Bounded AI investigation controls. The backend remains authoritative for facts.
AGENTIC_PLANNER_ENABLED=true
AGENT_DEEP_MODE_ENABLED=true
AGENT_MAX_TOOL_ROUNDS=2
KNOWLEDGE_ENABLED=true

# Paths are relative to the repository root unless absolute.
RAW_DATA_PATH=data/raw/ai4i2020.csv
PROCESSED_DATA_PATH=data/processed/ai4i2020_features.parquet
